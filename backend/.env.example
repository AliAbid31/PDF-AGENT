PROJECT_NAME="PDF Agent AI"
DATABASE_URL=

# Sécurité
JWT_SECRET_KEY=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Azure Blob Storage (Récupéré depuis le portail Azure)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_CONTAINER_NAME="pdf-documents"

# LLM (OpenAI ou Azure OpenAI)
GEMINI_API_KEY=

# Service Email (Resend - clé gratuite sur resend.com)
RESEND_API_KEY=
# In Resend testing mode, emails can only be sent to the Resend account email.
# To send to every user's email, verify a domain in Resend and use its address.
EMAIL_FROM="onboarding@resend.dev"

# Google OAuth (Google Cloud Console > Credentials > OAuth 2.0 Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
FRONTEND_URL="http://localhost:3000"